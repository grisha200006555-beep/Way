# --- LLM ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-haiku-4-5-20251001
CLAUDE_MODEL_HEAVY=claude-sonnet-4-6

# --- Telegram ---
# Get from @BotFather. Leave TELEGRAM_OWNER_ID empty until you know your numeric id
# (send /start to your bot, see logs).
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# --- GitHub (optional) ---
# Create at https://github.com/settings/tokens (fine-grained, repo + read access)
GITHUB_TOKEN=

# --- Gmail / GCal (optional) ---
# Setup is OAuth-heavy. See deploy/README.md when you're ready to wire it.
GOOGLE_CREDENTIALS_JSON=

# --- Web dashboard ---
WEB_HOST=0.0.0.0
WEB_PORT=8000
# Random string; protects the dashboard. Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
WEB_TOKEN=change-me

# --- Storage ---
# SQLite by default. For postgres: postgresql+psycopg://user:pass@localhost/agents
DATABASE_URL=sqlite:///./agents.db

# --- Safety ---
# Hard cap on tool-use iterations per task — stops runaway loops.
MAX_AGENT_ITERATIONS=15
# Hard cap on shell commands Sam can run. Empty = whitelist below.
SAM_SHELL_WHITELIST=ls,df,free,uptime,docker,systemctl,journalctl,uname,ps,top,cat,grep,tail,head
